#!/usr/bin/env bash
# git — ready-f75 stash guard, NON-HOOK half: a wrapper that sits earlier on
# PATH than the real git and refuses the mutating `git stash` verbs before
# they ever reach git.
#
# WHY A WRAPPER AT ALL. The hook half of this guard (see
# scripts/git-hooks/reference-transaction) is bounded by what git lets a hook
# see, and the bound turned out to depend on how deep the shared stack is.
# This wrapper exists because it has no such bound: it never invokes git for
# the mutating verbs, so no ref transaction, no reflog rewrite and no index
# write ever start, whatever the stack depth.
#
# WHAT EACH MECHANISM ACTUALLY STOPS IS NOT WRITTEN DOWN IN ANY SHIPPED FILE.
# Three review rounds of ready-f75 went on that claim in prose and each one
# was defeated by rewording. It lives in scripts/wt_stash_test.go instead,
# where it is executable and each mechanism is measured in isolation:
#
#   go test ./scripts/ -run TestStashGuard -v
#
# WHAT THIS WRAPPER DOES NOT COVER, which is a property of the wrapper itself
# rather than a claim about coverage:
#   * It only intercepts invocations that resolve `git` through PATH. An
#     absolute path (/usr/bin/git), a shell function, or a program that
#     execs git by absolute path goes straight past it.
#   * It only applies where something puts its directory on PATH. That is a
#     property of the process that SPAWNS an agent, not of this repository,
#     so this file cannot install itself the way the hooks can. The installer
#     materialises it and prints the exact export line; wiring it into the
#     dispatch harness is tracked separately.
#   * RD_STASH_GUARD_INTERNAL=1 passes straight through (that is how
#     wt-stash.sh runs its own `git stash create` / `git stash apply <sha>`),
#     so it is a guard against accident, not against an adversary.
#
# ready-f75 stash guard
set -uo pipefail

SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# --- find the real git, skipping ourselves ------------------------------
# Skipping our own directory is not enough: the installer materialises a
# SECOND copy of this file under .git/f75-stash-guard/bin, and if both copies
# end up on PATH each would find the other and exec it forever. So skip any
# candidate that is itself a copy of this guard, identified by its marker.
_real_git() {
  local dir resolved
  local IFS=:
  for dir in $PATH; do
    [[ -n "$dir" ]] || dir="."
    resolved="$(cd "$dir" 2>/dev/null && pwd -P)" || continue
    [[ "$resolved" == "$SHIM_DIR" ]] && continue
    [[ -x "$resolved/git" && ! -d "$resolved/git" ]] || continue
    if head -c 8192 "$resolved/git" 2>/dev/null | grep -q 'ready-f75 stash guard'; then
      continue
    fi
    printf '%s' "$resolved/git"
    return 0
  done
  return 1
}

REAL_GIT="$(_real_git)" || {
  echo "ready-f75 git shim: cannot find the real git on PATH (excluding $SHIM_DIR)." >&2
  echo "  Refusing to run rather than silently doing nothing." >&2
  exit 127
}

# wt-stash.sh sets this; it is the safe, per-worktree path.
if [[ "${RD_STASH_GUARD_INTERNAL:-}" == "1" ]]; then
  exec "$REAL_GIT" "$@"
fi

# --- locate the subcommand, skipping git's global options ---------------
# Global options that consume the FOLLOWING argument. `git -C dir stash pop`
# must not be read as subcommand "dir". (`--exec-path` is deliberately absent:
# its valued form is `--exec-path=<path>`, a single token.)
_takes_value() {
  case "$1" in
    -C | -c | --git-dir | --work-tree | --namespace | --super-prefix | --config-env) return 0 ;;
    *) return 1 ;;
  esac
}

args=("$@")
subcmd=""
next_arg=""
i=0
while [[ $i -lt ${#args[@]} ]]; do
  arg="${args[$i]}"
  if _takes_value "$arg"; then
    i=$((i + 2))
    continue
  fi
  if [[ "$arg" == -* ]]; then
    i=$((i + 1))
    continue
  fi
  subcmd="$arg"
  if [[ $((i + 1)) -lt ${#args[@]} ]]; then
    next_arg="${args[$((i + 1))]}"
  fi
  break
done

if [[ "$subcmd" != "stash" ]]; then
  exec "$REAL_GIT" "$@"
fi

# git's own rule: the token immediately after `stash` is the subcommand, and
# ONLY that token. If it is an option, or anything git would not recognise as
# a stash subcommand, this is the implicit-push form. Scanning further for the
# "first non-option argument" instead would read `git stash -m list` — which
# git executes as a PUSH with the message "list" — as a harmless `list`, and
# let it onto the shared stack. Fail closed: unknown means push.
stash_verb="push"
case "$next_arg" in
  push | save | list | show | apply | pop | drop | clear | create | store | branch)
    stash_verb="$next_arg"
    ;;
esac

case "$stash_verb" in
  # Read-only against the shared stack: no ref write, no index write.
  list | show)
    exec "$REAL_GIT" "$@"
    ;;
  # `git stash create` writes NO ref — it only produces a stash-shaped
  # commit. wt-stash.sh is built on it. Harmless, allowed.
  create)
    exec "$REAL_GIT" "$@"
    ;;
esac

# Everything else mutates the SHARED stack or the working tree from it:
# push, save, store, apply, pop, drop, clear, branch.
{
  echo "ready-f75 stash guard: REFUSED \`git stash $stash_verb\` (PATH shim, nothing was run)."
  echo
  echo "refs/stash lives in the COMMON .git directory that every git worktree of"
  echo "this repo SHARES. Two agents dispatched into separate worktrees push onto"
  echo "and pop from the same stack, and a pop by position silently applies and"
  echo "then deletes whichever sibling's entry is on top (observed 2026-07-29)."
  echo
  echo "Use the worktree-scoped replacement, whose entries live under"
  echo "refs/worktree/wtstash/N (git stores those per worktree):"
  echo "  git wtstash [push|list|pop|apply|drop|clear]"
  echo
  echo "Or commit the WIP on your own branch — a dispatched agent owns its branch"
  echo "and can reset or amend it later."
  echo
  echo "Deliberate override (you are then responsible for the shared stack):"
  echo "  RD_STASH_GUARD_INTERNAL=1 git stash $stash_verb"
} >&2

exit 1
