#!/usr/bin/env bash
# post-index-change — ready-f75 stash guard (detection half).
#
# `git stash apply` opens NO ref transaction, so the reference-transaction
# hook never sees it, and `git stash pop` applies BEFORE it drops. There is
# no abortable pre-apply hook anywhere in git: post-index-change is the only
# hook that fires at all, and git IGNORES its exit code (measured on git
# 2.43 — a post-index-change returning 1 leaves `git stash apply` at exit 0
# with the working tree already rewritten).
#
# So this hook cannot prevent a shared-stash apply. What it CAN do is make it
# LOUD. The 2026-07-29 incident's defining property was silence: "Nothing
# failed loudly here; it was caught only because one agent chose to disclose
# it." This hook removes that property — an agent that applies or pops from
# the shared stack now gets told, on stderr, at the moment their working tree
# changed, that the content may be another worktree's.
#
# KNOW WHAT THIS IS WORTH. On a shared stack holding two or more entries —
# the live ready clone holds 27 — this warning is the ENTIRE contribution of
# the git hooks to apply and pop, because the sibling reference-transaction
# hook has no ref-level effect at that depth (measured at depth 1, 2, 3 and
# 5). It is a smoke alarm, not a lock. `git stash drop` at depth 2 or more
# does not even reach this hook: it touches no working tree, so nothing warns
# at all. The mechanism that actually holds at arbitrary depth is the PATH
# shim, scripts/git-shim/git, which never invokes git for these verbs.
#
# It speaks ONLY for `git stash apply` / `git stash pop`. Every other index
# write in the repo (add, commit, checkout, reset, merge, rebase, and
# `git wtstash`'s own internal `git stash apply <sha>`) passes silently.
#
# Args, per githooks(5): $1 = "1" if the working directory was updated,
# $2 = "1" if the index was updated. We warn on the working-directory-update
# event, which fires exactly once per apply and is the moment the damage
# lands.
#
# ready-f75 stash guard
set -uo pipefail

# `git wtstash` uses `git stash create` + `git stash apply <sha>` internally
# against its OWN per-worktree refs. That is the safe path, not the hazard.
[[ "${RD_STASH_GUARD_INTERNAL:-}" == "1" ]] && exit 0

worktree_updated="${1:-0}"
[[ "$worktree_updated" == "1" ]] || exit 0

# Which user-facing `git ...` are we inside? git runs parts of stash from
# internal subprocesses, so walk up the process tree. Linux /proc only; on a
# system without /proc this hook is simply silent (it can never block, so a
# missing warning is the only cost).
_invoking_git_cmd() {
  local pid="$PPID" cmd ppid depth=0
  while [[ -n "$pid" && "$pid" != "0" && "$depth" -lt 8 ]]; do
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null) || return 0
    if [[ "$cmd" == *"stash"* ]]; then
      printf '%s' "${cmd% }"
      return 0
    fi
    ppid=$(sed -e 's/^.*) [A-Za-z] //' "/proc/$pid/stat" 2>/dev/null | cut -d' ' -f1)
    [[ "$ppid" == "$pid" ]] && return 0
    pid="$ppid"
    depth=$((depth + 1))
  done
}

verb="$(_invoking_git_cmd)"
case "$verb" in
  *"stash apply"* | *"stash pop"*) ;;
  *) exit 0 ;;
esac

# NOTE: `git wtstash` is exempted solely by RD_STASH_GUARD_INTERNAL above,
# which is measured to reach this hook (git passes its environment through to
# hooks; verified for `git wtstash`, and confirmed unset for an ordinary
# `git add`). An earlier version ALSO exempted any invocation whose command
# line contained a 40-hex object id, on the theory that only wt-stash.sh
# applies by explicit SHA. That was redundant and it was a hole: it silenced a
# hand-typed `git stash apply <sha>` against a shared entry, which is exactly
# the hazard this hook exists to surface.

{
  echo "ready-f75 stash guard: WARNING — you just applied from the SHARED stash stack."
  echo "  invoked by: $verb"
  echo
  echo "refs/stash lives in the COMMON .git directory that every git worktree of"
  echo "this repo shares, so the entry you just applied may have been created by"
  echo "a DIFFERENT dispatched agent in a different worktree, and your working"
  echo "tree may now contain its content mixed into yours."
  echo
  echo "No git hook can prevent this: 'git stash apply' opens no ref transaction,"
  echo "and 'git stash pop' applies before it drops. Verify with 'git status'"
  echo "and 'git diff'."
  echo
  echo "This warning is ALL the git hooks give you here, and on a stack holding"
  echo "two or more entries it is all they give you for pop as well — the"
  echo "reference-transaction hook has no ref-level effect at that depth. Treat"
  echo "it as a smoke alarm, not a lock."
  echo
  echo "Use 'git wtstash [push|list|pop|apply|drop|clear]' instead — it is scoped"
  echo "to refs/worktree/wtstash/N, which git stores per worktree. To make this"
  echo "case impossible rather than merely audible, put scripts/git-shim earlier"
  echo "on PATH than the real git."
} >&2

exit 0
