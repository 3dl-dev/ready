#!/usr/bin/env bash
# reference-transaction — ready-f75 stash guard (blocking half).
#
# WHY: refs/stash lives in the repository's COMMON .git directory — the one
# piece of state every `git worktree` of a repo SHARES. Two agents dispatched
# into separate worktrees who both run `git stash` push onto the SAME stack;
# a pop by position can apply-then-delete the OTHER agent's entry with no
# error at all. Observed 2026-07-29: 14+ interleaved entries from 10
# branches, one agent's `git stash pop` reverting a sibling's uncommitted
# files to HEAD, caught only because that agent volunteered it.
#
# WHAT THIS HOOK ACTUALLY COVERS — measured on git 2.43, not assumed. Do not
# widen this claim without re-measuring; an earlier version of this file
# claimed it blocked push/pop/apply/drop/clear and that was false:
#
#   BLOCKED HERE, BEFORE ANY DAMAGE
#     * `git stash` / `git stash push`  — the operation that creates the
#       cross-worktree hazard in the first place. The transaction is aborted
#       before the working tree is reset, so the caller keeps their changes
#       and nothing lands on the shared stack.
#     * `git stash clear`  — a single refs/stash deletion with no preceding
#       reflog rewrite, so aborting it preserves every entry. Measured: with
#       entries on the stack, `git stash clear` exits 128 and `git stash
#       list` is unchanged.
#
#   NOT BLOCKABLE BY ANY GIT HOOK — do not pretend otherwise
#     * `git stash apply` performs NO ref transaction whatsoever, so this
#       hook never runs for it. The only hook git fires is
#       post-index-change, whose exit code git ignores (measured: a
#       post-index-change returning 1 leaves `git stash apply` at exit 0
#       with the working tree already rewritten). See the sibling
#       post-index-change hook, which turns that unblockable case into a
#       LOUD warning instead of a silent one.
#     * `git stash drop`, and the drop half of `git stash pop`, rewrite the
#       refs/stash REFLOG first, via `git reflog delete --rewrite
#       --updateref`, which does not open a ref transaction. By the time this
#       hook sees anything the entry is already off `git stash list`. What
#       aborting the trailing ref deletion DOES buy: when the dropped entry
#       was the last one, refs/stash keeps pointing at it instead of being
#       deleted, so the commit stays reachable and recoverable
#       (`git stash apply refs/stash`) rather than becoming garbage.
#     * `git stash pop` applies BEFORE it drops, so even in the case where
#       this hook does fire, the working tree has already changed.
#
# The upshot: this hook makes the shared stack UNGROWABLE (no new entry can
# land on it) and UNCLEARABLE (no bulk deletion). Once the stack is also
# EMPTY, raw `git stash pop`/`apply`/`drop` all fail at stash@{0} resolution
# with "No stash entries found." and zero working-tree damage — measured.
# That is the end state in which every verb is safe.
#
# Ungrowable is what actually closes the observed incident: agent A's work can
# no longer reach the shared stack, so agent B's pop can no longer discard it.
# What remains is an agent popping a PRE-EXISTING entry into its own tree.
# Emptying that backlog is data deletion and is owner-reserved (ready-bef);
# until then the post-index-change hook is what makes it visible instead of
# silent.
#
# Full per-hazard analysis of the rest of the shared .git directory:
# docs/ops/shared-git-state-audit.md
#
# Installed by scripts/install-git-stash-guard.sh. Marker line below is what
# makes installation idempotent and what stops the installer from silently
# overwriting somebody else's reference-transaction hook:
# ready-f75 stash guard
set -uo pipefail

# refs/stash is the real target. The canary ref exists only so the installer
# can prove, empirically and without touching refs/stash, that git actually
# runs THIS file in THIS repository (core.hooksPath can point anywhere).
GUARDED_REFS_RE='^refs/(stash|f75-stash-guard-canary)$'

state="${1:-}"
[[ "$state" == "prepared" ]] || exit 0

# Which user-facing `git ...` triggered us? git may run the ref update from
# an internal subprocess (e.g. `git reflog delete` under `git stash drop`),
# so walk up the process tree. Linux /proc only; absent /proc we simply
# report the verb as unknown and still block.
_invoking_git_cmd() {
  local pid="$PPID" cmd ppid depth=0
  while [[ -n "$pid" && "$pid" != "0" && "$depth" -lt 8 ]]; do
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null) || return 0
    if [[ "$cmd" == *"stash"* ]]; then
      printf '%s' "${cmd% }"
      return 0
    fi
    # /proc/<pid>/stat field 4 is ppid, but field 2 (comm) may contain
    # spaces and parens, so strip through the last ')' before counting.
    ppid=$(sed -e 's/^.*) [A-Za-z] //' "/proc/$pid/stat" 2>/dev/null | cut -d' ' -f1)
    [[ "$ppid" == "$pid" ]] && return 0
    pid="$ppid"
    depth=$((depth + 1))
  done
}

blocked_ref=""
blocked_old=""
blocked_new=""
while read -r old new refname; do
  if [[ "$refname" =~ $GUARDED_REFS_RE ]]; then
    blocked_ref="$refname"
    blocked_old="$old"
    blocked_new="$new"
    break
  fi
done

[[ -n "$blocked_ref" ]] || exit 0

verb="$(_invoking_git_cmd)"
{
  echo "ready-f75 stash guard: REFUSED a write to $blocked_ref"
  echo "  $blocked_old -> $blocked_new"
  if [[ -n "$verb" ]]; then
    echo "  invoked by: $verb"
  fi
  if [[ "$blocked_ref" == "refs/stash" ]]; then
    echo
    echo "refs/stash lives in the COMMON .git directory that every git worktree"
    echo "of this repo shares. A stash pushed from one dispatched agent's worktree"
    echo "lands on the same stack every other agent pops from, and a pop by"
    echo "position silently discards whichever sibling's entry happens to be on"
    echo "top (observed 2026-07-29, ready-f75)."
    echo
    echo "Use the worktree-scoped replacement — its entries live under"
    echo "refs/worktree/wtstash/N, which git stores per worktree:"
    echo "  git wtstash [push|list|pop|apply|drop|clear]"
    echo
    echo "Or just commit the WIP on your own branch; a dispatched agent owns its"
    echo "branch and can always reset/amend it later."
    case "$verb" in
      *"stash pop"* | *"stash drop"*)
        echo
        echo "NOTE: this refusal did NOT undo anything. drop (and the drop half of"
        echo "pop) rewrites the refs/stash reflog before any transaction opens, so"
        echo "the entry is already off 'git stash list'; pop also applies before it"
        echo "drops, so your working tree may already have changed. Refusing the"
        echo "trailing ref deletion only keeps the entry REACHABLE — recover it with"
        echo "  git stash apply refs/stash"
        echo "Check 'git status' and 'git diff' before doing anything else."
        ;;
    esac
    echo
    echo "This hook cannot block 'git stash apply', or the reflog-rewrite half of"
    echo "drop/pop: neither opens a ref transaction, so no hook runs. See"
    echo "docs/ops/shared-git-state-audit.md for the measurements."
  else
    echo
    echo "(That was the guard's own self-check canary. If you see this from"
    echo "anything other than scripts/install-git-stash-guard.sh, ignore it.)"
  fi
} >&2

exit 1
