#!/usr/bin/env bash
# reference-transaction — ready-f75 stash guard (blocking half).
#
# WHY: refs/stash lives in the repository's COMMON .git directory — the one
# piece of state every `git worktree` of a repo SHARES. Two agents dispatched
# into separate worktrees who both stash are pushing onto the SAME stack; a
# pop by position can apply-then-delete the OTHER agent's entry with no error
# at all. Observed 2026-07-29: 14+ interleaved entries from 10 branches, one
# agent's pop reverting a sibling's uncommitted files to HEAD, caught only
# because that agent volunteered it.
#
# EXACT COVERAGE. The table below is not prose: every row is re-derived on
# every test run by TestStashGuard_DocumentedCoverageMatchesMeasuredCoverage,
# which runs each verb against a really-installed guard on a realistic shared
# stack and fails if the table and the measurement disagree. An earlier
# version of this file asserted coverage it did not have, which is why the
# claim is machine-checked rather than written down.
#
# ready-f75 coverage table BEGIN
#   mechanism: git-hooks
#     blocked-pre-damage: push save clear
#     not-blocked: apply pop drop
#     depth-limit: REF-EFFECTIVE ONLY AT DEPTH <= 1. At a shared-stack depth
#       of 1 the trailing refs/stash deletion is refused, but the entry has
#       already left `git stash list` by then; the refusal only keeps the
#       commit reachable via refs/stash. At depth 2 or more there is no
#       ref-level effect whatsoever — exit 0, entry consumed, sibling content
#       in the caller's tree. Measured at depth 1, 2, 3 and 5. The live ready
#       clone sits at depth 27, i.e. in the row with no ref-level effect, so
#       at realistic depth the post-index-change warning is the whole of the
#       hooks' coverage — and for drop at depth >= 2 there is not even that.
#   mechanism: path-shim
#     blocked-pre-damage: push save apply pop drop clear
#     not-blocked: (none)
#     depth-limit: none — scripts/git-shim/git never invokes git for these
#       verbs, so shared-stack depth is irrelevant. It applies only where its
#       directory is earlier on PATH than the real git, which is a property
#       of the process that spawns an agent and cannot be installed from
#       inside this repository the way the hooks can.
# ready-f75 coverage table END
#
# WHY THE HOOKS CANNOT DO BETTER, verb by verb, on git 2.43.
#   * `git stash apply` performs NO ref transaction, so this hook never runs
#     for it. The only hook git fires is post-index-change, whose exit code
#     git ignores — a post-index-change returning 1 still leaves apply at
#     exit 0 with the working tree already rewritten. The sibling
#     post-index-change hook turns that unstoppable case into a LOUD warning
#     instead of a silent one.
#   * `git stash drop`, and the drop half of `git stash pop`, rewrite the
#     refs/stash REFLOG first, via `git reflog delete --rewrite --updateref`,
#     which opens no ref transaction. By the time this hook sees anything the
#     entry is already off `git stash list`.
#   * `git stash pop` applies BEFORE it drops, so even where this hook does
#     fire, the working tree has already changed.
#
# So what the hooks buy is that the shared stack becomes UNGROWABLE and
# UNCLEARABLE. Ungrowable is what severs the observed incident: agent A's
# work can no longer reach the shared stack, so agent B's pop can no longer
# discard it. What remains is an agent consuming a PRE-EXISTING entry, and at
# the depths this repo actually runs at, only the PATH shim and an empty
# stack close that. Emptying the backlog is data deletion and is
# owner-reserved (ready-bef). Once the stack is EMPTY, raw pop/apply/drop all
# fail at stash@{0} resolution with "No stash entries found." and zero
# working-tree damage — measured. That is the end state in which every verb
# is safe with no guard at all.
#
# Full per-hazard analysis of the rest of the shared .git directory:
# docs/ops/shared-git-state-audit.md
#
# Installed by scripts/install-git-stash-guard.sh. Marker line below is what
# makes installation idempotent and what stops the installer from silently
# overwriting somebody else's reference-transaction hook:
# ready-f75 stash guard
set -uo pipefail

# refs/stash is the real target. The canary ref exists only so the installer
# can prove, empirically and without touching refs/stash, that git actually
# runs THIS file in THIS repository (core.hooksPath can point anywhere).
GUARDED_REFS_RE='^refs/(stash|f75-stash-guard-canary)$'

state="${1:-}"
[[ "$state" == "prepared" ]] || exit 0

# Which user-facing `git ...` triggered us? git may run the ref update from
# an internal subprocess (e.g. `git reflog delete` under `git stash drop`),
# so walk up the process tree. Linux /proc only; absent /proc we simply
# report the verb as unknown and still block.
_invoking_git_cmd() {
  local pid="$PPID" cmd ppid depth=0
  while [[ -n "$pid" && "$pid" != "0" && "$depth" -lt 8 ]]; do
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null) || return 0
    if [[ "$cmd" == *"stash"* ]]; then
      printf '%s' "${cmd% }"
      return 0
    fi
    # /proc/<pid>/stat field 4 is ppid, but field 2 (comm) may contain
    # spaces and parens, so strip through the last ')' before counting.
    ppid=$(sed -e 's/^.*) [A-Za-z] //' "/proc/$pid/stat" 2>/dev/null | cut -d' ' -f1)
    [[ "$ppid" == "$pid" ]] && return 0
    pid="$ppid"
    depth=$((depth + 1))
  done
}

blocked_ref=""
blocked_old=""
blocked_new=""
while read -r old new refname; do
  if [[ "$refname" =~ $GUARDED_REFS_RE ]]; then
    blocked_ref="$refname"
    blocked_old="$old"
    blocked_new="$new"
    break
  fi
done

[[ -n "$blocked_ref" ]] || exit 0

verb="$(_invoking_git_cmd)"
{
  echo "ready-f75 stash guard: REFUSED a write to $blocked_ref"
  echo "  $blocked_old -> $blocked_new"
  if [[ -n "$verb" ]]; then
    echo "  invoked by: $verb"
  fi
  if [[ "$blocked_ref" == "refs/stash" ]]; then
    echo
    echo "refs/stash lives in the COMMON .git directory that every git worktree"
    echo "of this repo shares. A stash pushed from one dispatched agent's worktree"
    echo "lands on the same stack every other agent pops from, and a pop by"
    echo "position silently discards whichever sibling's entry happens to be on"
    echo "top (observed 2026-07-29, ready-f75)."
    echo
    echo "Use the worktree-scoped replacement — its entries live under"
    echo "refs/worktree/wtstash/N, which git stores per worktree:"
    echo "  git wtstash [push|list|pop|apply|drop|clear]"
    echo
    echo "Or just commit the WIP on your own branch; a dispatched agent owns its"
    echo "branch and can always reset/amend it later."
    case "$verb" in
      *"stash pop"* | *"stash drop"*)
        echo
        echo "NOTE: this refusal did NOT undo anything, and you only saw it because"
        echo "the shared stack was down to its LAST entry. The reflog rewrite already"
        echo "happened, so the entry is off 'git stash list'; pop also applies before"
        echo "it drops, so your working tree may already have changed. Aborting the"
        echo "trailing ref deletion only keeps the entry REACHABLE — recover it with"
        echo "  git stash apply refs/stash"
        echo "Check 'git status' and 'git diff' before doing anything else."
        echo
        echo "AT A SHARED-STACK DEPTH OF 2 OR MORE YOU WOULD NOT HAVE SEEN THIS AT"
        echo "ALL: the same command exits 0, consumes the entry, and for drop prints"
        echo "nothing. Do not read this refusal as protection at depth."
        ;;
    esac
    echo
    echo "The hooks stop 'git stash push', 'save' and 'clear' before any damage."
    echo "They cannot stop 'git stash apply', 'pop' or 'drop': neither the apply"
    echo "nor the reflog-rewrite half opens a ref transaction, so no hook runs."
    echo "Only the PATH shim (scripts/git-shim) stops those, at any stack depth."
    echo "Measurements: docs/ops/shared-git-state-audit.md"
  else
    echo
    echo "(That was the guard's own self-check canary. If you see this from"
    echo "anything other than scripts/install-git-stash-guard.sh, ignore it.)"
  fi
} >&2

exit 1
